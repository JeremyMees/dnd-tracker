{
  "name": "dnd-tracker",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "sb:types": "npx supabase gen types --lang=typescript --project-id nvqbozqxmtyvuslofrvs > shared/types/database-generated.ts",
    "sb:schema": "npx supabase db dump --project-ref nvqbozqxmtyvuslofrvs --schema public -f supabase/schema.sql",
    "avatar:options": "tsx scripts/generate-avatar-options.ts",
    "prepare": "husky",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:coverage:gate": "nyc report --temp-dir=coverage-raw --report-dir=coverage --reporter=text --reporter=lcov && nyc check-coverage --temp-dir=coverage-raw --lines 80 --functions 80 --branches 80 --statements 80",
    "deps": "npx taze -w",
    "open5e:sync": "tsx --env-file-if-exists=.env scripts/sync-open5e.ts",
    "stripe": "stripe listen --forward-to localhost:3000/api/stripe/webhooks"
  },
  "engines": {
    "pnpm": "please-use-npm",
    "yarn": "please-use-npm",
    "npm": ">=10.0.0",
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@c15t/integrations": "^3.0.0",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@formkit/auto-animate": "^0.10.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "^5.3.16",
    "@nuxtjs/supabase": "^2.0.10",
    "@sentry/nuxt": "^11.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.104.2",
    "@tanstack/vue-table": "^9.3.1",
    "@tiptap/extension-highlight": "3.30.3",
    "@tiptap/extensions": "3.30.3",
    "@tiptap/pm": "3.30.3",
    "@tiptap/starter-kit": "3.30.3",
    "@tiptap/vue-3": "3.30.3",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "c15t": "^3.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dedupe": "^4.0.3",
    "deepmerge": "^4.3.1",
    "dompurify": "^3.4.17",
    "driver.js": "^1.9.0",
    "jose": "^6.2.12",
    "marked": "^18.1.1",
    "motion-v": "^2.7.0",
    "nuxt": "^4.6.1",
    "nuxt-authorization": "^0.3.5",
    "qr": "^0.7.2",
    "reka-ui": "^2.11.0",
    "sanitize-html": "^2.18.0",
    "shadcn-nuxt": "^2.8.2",
    "stripe": "^23.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "type-fest": "^5.10.0",
    "unstorage": "^1.17.5",
    "vee-validate": "^5.0.0-beta.1",
    "vue": "latest",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "latest",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@golar/vue": "^0.1.10",
    "@iconify-json/tabler": "^1.2.42",
    "@inspira-ui/plugins": "^0.0.2",
    "@maizzle/framework": "^6.2.1",
    "@maizzle/nuxt": "^1.0.0",
    "@nuxt/test-utils": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.2",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "golar": "^0.1.10",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "magic-string": "^1.4.3",
    "nyc": "^18.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unimport": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@intlify/unplugin-vue-i18n": {
      "@intlify/vue-i18n-extensions": "^9.0.0"
    },
    "nitro": {
      "vite": "^8.0.0"
    },
    "vue": "latest"
  }
}
